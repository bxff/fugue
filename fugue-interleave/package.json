{
    "name": "fugue-interleave",
    "version": "1.0.0",
    "description": "Fugue interleave test with commutativity fuzzer",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "start": "node index.js",
        "fuzz": "node fuzzer.js",
        "fuzz:verbose": "node fuzzer.js 100 --verbose",
        "fuzz:long": "node fuzzer.js 10000",
        "fuzz:property": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=property-based --testTimeout=300000",
        "fuzz:coverage": "npx @jazzer.js/core jazzer-target.cjs corpus/ --sync",
        "generate-trace": "node generate-trace.js",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testTimeout=60000 --testPathIgnorePatterns=fuzz.test.js",
        "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch --testPathIgnorePatterns=fuzz.test.js"
    },
    "dependencies": {
        "@collabs/collabs": "0.13.4",
        "fugue": "file:../fugue",
        "fugue-max-simple": "file:../fugue-max-simple",
        "seedrandom": "^3.0.5"
    },
    "devDependencies": {
        "@jazzer.js/core": "^2.1.0",
        "@jazzer.js/jest-runner": "^2.1.0",
        "fast-check": "^4.5.2",
        "jest": "^29.7.0",
        "jsfuzz": "^1.0.15"
    }
}
